# Copy to .env for local development. In Dokploy, set these as Environment variables.
# If the password contains special characters (@ : / ? #), URL-encode them (@ -> %40).
MONGODB_URI=mongodb://USER:PASSWORD@HOST:27017/?authSource=admin&directConnection=true
MONGODB_DB=techly
# Long random string. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
PORT=4000
# Keep "false" only for local http://localhost. Leave unset (true) in production (https).
COOKIE_SECURE=false
